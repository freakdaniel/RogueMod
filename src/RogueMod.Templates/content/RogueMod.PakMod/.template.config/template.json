{
  "$schema": "http://json.schemastore.org/template",
  "author": "RogueMod contributors",
  "classifications": ["RogueMod", "Deadzone Rogue", "Mod", "Pak"],
  "identity": "RogueMod.Templates.PakMod",
  "name": "RogueMod pak mod",
  "shortName": "roguemod-pak",
  "sourceName": "RogueMod.PakMod",
  "defaultName": "MyRoguePakMod",
  "preferNameDirectory": true,
  "sources": [{"source":"./","target":"./","rename":{"gitignore.txt":".gitignore"}}],
  "symbols": {
    "mod-id": {"type":"parameter","datatype":"text","defaultValue":"sample.pak-mod","description":"Stable lowercase package identifier.","replaces":"sample.pak-mod"},
    "mod-name": {"type":"parameter","datatype":"text","defaultValue":"Sample pak mod","description":"Human-readable mod name.","replaces":"Sample pak mod"}
  }
}
