<Project>
  <PropertyGroup>
    <RogueModArtifactsRoot Condition="'$(RogueModArtifactsRoot)' == ''">$(MSBuildProjectDirectory)/.artifacts</RogueModArtifactsRoot>
    <RogueModPackageOutput Condition="'$(RogueModPackageOutput)' == ''">$(RogueModArtifactsRoot)/packages/managed/$(Configuration)/$(RogueModModId)</RogueModPackageOutput>
    <RogueModManifestFile Condition="'$(RogueModManifestFile)' == '' and Exists('$(MSBuildProjectDirectory)/mod.json')">$(MSBuildProjectDirectory)/mod.json</RogueModManifestFile>
  </PropertyGroup>

  <Target Name="ValidateRogueModPackageProperties">
    <Error Condition="'$(RogueModModId)' == ''" Text="RogueModModId is required." />
    <Error Condition="'$(RogueModManifestFile)' != '' and !Exists('$(RogueModManifestFile)')" Text="RogueModManifestFile does not exist: $(RogueModManifestFile)" />
    <Error Condition="'$(RogueModManifestFile)' == '' and '$(RogueModModName)' == ''" Text="RogueModModName is required when no mod.json is provided." />
    <Error Condition="'$(RogueModManifestFile)' == '' and '$(RogueModEntryPoint)' == ''" Text="RogueModEntryPoint is required when no mod.json is provided." />
  </Target>

  <Target Name="PackageRogueMod"
          DependsOnTargets="Build;ValidateRogueModPackageProperties">
    <PropertyGroup>
      <_RogueModDllDirectory>$(RogueModPackageOutput)/dlls</_RogueModDllDirectory>
      <_RogueModManifest>{&quot;id&quot;:&quot;$(RogueModModId)&quot;,&quot;name&quot;:&quot;$(RogueModModName)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;kind&quot;:&quot;managed&quot;,&quot;entryPoint&quot;:&quot;dlls/$(TargetFileName)::$(RogueModEntryPoint)&quot;}</_RogueModManifest>
    </PropertyGroup>

    <ItemGroup>
      <_RogueModRuntimeFile Include="$(TargetPath)" />
      <_RogueModRuntimeFile Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.Filename)' != 'RogueMod.Abstractions'
                                      and '%(ReferenceCopyLocalPaths.Filename)' != 'RogueMod.Sdk'
                                      and '%(ReferenceCopyLocalPaths.Filename)' != 'DeadzoneRogue.Sdk'" />
      <_RogueModMediaFile Include="$(MSBuildProjectDirectory)/media/**/*" />
    </ItemGroup>

    <RemoveDir Directories="$(RogueModPackageOutput)" />
    <MakeDir Directories="$(_RogueModDllDirectory)" />
    <Copy SourceFiles="@(_RogueModRuntimeFile)"
          DestinationFolder="$(_RogueModDllDirectory)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(RogueModManifestFile)"
          DestinationFiles="$(RogueModPackageOutput)/mod.json"
          Condition="'$(RogueModManifestFile)' != ''" />
    <WriteLinesToFile File="$(RogueModPackageOutput)/mod.json"
                      Lines="$(_RogueModManifest)"
                      Overwrite="true"
                      Encoding="UTF-8"
                      Condition="'$(RogueModManifestFile)' == ''" />
    <Copy SourceFiles="@(_RogueModMediaFile)"
          DestinationFiles="@(_RogueModMediaFile->'$(RogueModPackageOutput)/media/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_RogueModMediaFile)' != ''" />

    <Message Importance="high" Text="RogueMod package: $(RogueModPackageOutput)" />
  </Target>
</Project>
