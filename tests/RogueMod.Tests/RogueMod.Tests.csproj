    <AssemblyName>RogueMod.Tests</AssemblyName>
    <RootNamespace>RogueMod.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
